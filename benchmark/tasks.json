  "tasks": [
    {
      "id": "A01",
      "type": "A",
      "name": "One-shot axial focus at 80 mm",
      "prompt": "请在 [0, 0, 80] mm 处进行一次近场聚焦仿真，只运行一次，并报告实际峰值位置、峰值功率和相对目标点的聚焦误差。",
      "task_config": {
        "desired_target_mm": [0, 0, 80],
        "tolerance_mm": 5.0,
        "max_refinements": 0
      },
      "expected_workflow": {
        "required_sequence": ["create_focus_task", "run_focus_simulation", "evaluate_focus"],
        "terminal_rule": "stop_after_first_evaluation_and_report",
        "allow_refine": false
      },
      "requires_real_matlab": true
    },
    {
      "id": "A02",
